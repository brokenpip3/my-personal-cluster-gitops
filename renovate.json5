{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  dependencyDashboardTitle: 'Dependencies',
  flux: {
    managerFilePatterns: [
      '/clusters/.+\\.ya?ml$/',
      '/apps/.+\\.ya?ml$/',
      '/infra/.+\\.ya?ml$/',
      '/ci-cd/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/clusters/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/clusters/.+\\.ya?ml$/',
      '/apps/.+\\.ya?ml$/',
      '/infra/.+\\.ya?ml$/',
      '/ci-cd/.+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Match Helm values for non-standard yamls',
      managerFilePatterns: [
        '/infra/.+\\.ya?ml$/',
      ],
      matchStringsStrategy: 'any',
      matchStrings: [
        'repository:\\s?"?(?<depName>[^\\s"]*)"?\\s*?tag:\\s?"?(?<currentValue>[^\\s"]*)"?',
        'imageName:\\s?"?(?<depName>[^\\s"]*)"?\\s*?:\\s?"?(?<currentValue>[^\\s"]*)"?',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      description: [
        'Process custom dependencies',
      ],
      managerFilePatterns: [
        '/apps/.+\\.ya?ml$/',
        '/infra/.+\\.ya?ml$/',
        '/ci-cd/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+: (&\\S+\\s)?(?<currentValue>\\S+)',
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
    },
  ],
  packageRules: [
    {
      matchDatasources: [
        'helm',
      ],
      matchManagers: [
        'flux',
      ],
      matchPackageNames: [
        'loki',
        'promtail',
      ],
      registryUrls: [
        'https://grafana.github.io/helm-charts',
      ],
    },
    {
      matchDatasources: [
        'helm',
      ],
      matchManagers: [
        'flux',
      ],
      matchPackageNames: [
        'kube-prometheus-stack',
        'prometheus',
      ],
      registryUrls: [
        'https://prometheus-community.github.io/helm-charts',
      ],
    },
    {
      description: 'Ignore fluxcd images updated by flux operator',
      matchDatasources: [
        'docker',
      ],
      matchPackagePrefixes: [
        'fluxcd/',
        'ghcr.io/fluxcd/',
      ],
      enabled: false,
    },
    {
      description: 'Ignore fluxcd helm chart updates',
      matchDatasources: [
        'helm',
      ],
      matchManagers: [
        'flux',
        'helm-values',
      ],
      matchPackageNames: [
        'fluxcd/flux2',
        'fluxcd/flux',
      ],
      enabled: false,
    },
  ],
}
